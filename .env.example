SANDBOX_BASE_URL=http://39.98.58.9:28080
SANDBOX_API_KEY=

# APIG management plane (create / refresh). Leave empty when using SANDBOX_DOCKER_CONTAINER.
SANDBOX_APIG_ENDPOINT=https://apig.example.com
SANDBOX_APIG_HW_ID=
SANDBOX_APIG_HW_APPKEY=
SANDBOX_TEMPLATE_ID=
SANDBOX_INSTANCE_TIMEOUT=900
SANDBOX_REFRESH_DURATION=900
SANDBOX_KEEPALIVE_MARGIN_SECONDS=120
SANDBOX_KEEPALIVE_INTERVAL_SECONDS=15
SANDBOX_READY_TIMEOUT_SECONDS=15

# Local docker sandbox: set container name to bypass APIG + HTTP API
SANDBOX_DOCKER_CONTAINER=

OPENCODE_MODEL=local/Qwen3.6-35B-A3B-oQ4-mtp
OPENCODE_TIMEOUT_SECONDS=600
WORKER_MAX_WORKERS=2
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=0

# 远程排查日志（隔离网建议落盘）
# LOG_LEVEL: DEBUG|INFO|WARNING|ERROR（默认 INFO）
LOG_LEVEL=INFO
# 可选日志文件路径；为空则只输出到标准输出
# LOG_FILE=/var/log/sandbox-proxy.log
LOG_FILE=

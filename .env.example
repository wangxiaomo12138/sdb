SANDBOX_BASE_URL=http://39.98.58.9:28080
SANDBOX_API_KEY=

# APIG management plane (create / refresh). Leave empty when using SANDBOX_DOCKER_CONTAINER.
SANDBOX_APIG_ENDPOINT=https://apig.example.com
SANDBOX_APIG_HW_ID=
SANDBOX_APIG_HW_APPKEY=
SANDBOX_TEMPLATE_ID=
SANDBOX_INSTANCE_TIMEOUT=900
SANDBOX_REFRESH_DURATION=900
SANDBOX_KEEPALIVE_MARGIN_SECONDS=120
SANDBOX_KEEPALIVE_INTERVAL_SECONDS=15
SANDBOX_READY_TIMEOUT_SECONDS=15
# HTTPS：Postman 能通而 Python 握手超时，推荐下面这组
SANDBOX_APIG_SSL_VERIFY=false
SANDBOX_APIG_CA_BUNDLE=
# auto=最低TLS1.2可协商1.3；勿轻易锁死成1.2（部分网关反而握手挂起）
SANDBOX_APIG_TLS_VERSION=auto
SANDBOX_APIG_SSL_COMPAT=true
SANDBOX_APIG_PREFER_IPV4=true
# 默认不吃系统 HTTP(S)_PROXY，避免和 Postman 代理环境不一致
SANDBOX_APIG_TRUST_ENV=false
# requests（默认，贴近 Postman）| stdlib | httpx；失败会自动互切重试
SANDBOX_APIG_HTTP_BACKEND=requests
SANDBOX_APIG_CONNECT_TIMEOUT_SECONDS=30
SANDBOX_APIG_TIMEOUT_SECONDS=120
# requests/httpx 可用；出网需代理时填写，例如 http://127.0.0.1:7890
SANDBOX_APIG_PROXY=

# 执行 opencode 时注入的环境变量（JSON 对象；值里的 $PATH 等在沙箱 shell 中展开，不会在本机展开）
SANDBOX_ENV_VARS={"PATH":"xxx/bin:$PATH","XDG_CONFIG_HOME":"xxx/config","XDG_CACHE_HOME":"xxx/cache"}

# 创建沙箱时的双 NAS 挂载（APIG body.x-mounts，对象数组，最多 2 项）
# 各组 workspaceId 为空则跳过该项；两项都空则不传 x-mounts
SANDBOX_NAS_USER_DATA_WORKSPACE_ID=
SANDBOX_NAS_USER_DATA_SUBPATH=
SANDBOX_NAS_USER_DATA_MOUNT_PATH=
# true/false；留空表示不传 readOnly
SANDBOX_NAS_USER_DATA_READ_ONLY=

SANDBOX_NAS_OPENCODE_WORKSPACE_ID=
SANDBOX_NAS_OPENCODE_SUBPATH=
SANDBOX_NAS_OPENCODE_MOUNT_PATH=
SANDBOX_NAS_OPENCODE_READ_ONLY=

# 沙箱内绝对路径：OpenCode 离线包源/目标（创建环境时拷贝）、skill 存放目录
OPENCODE_OFFLINE_EXTRACT_PATH=
OPENCODE_OFFLINE_STORE_PATH=
SKILL_FILE_STORE_PATH=

# Local docker sandbox: set container name to bypass APIG + HTTP API
SANDBOX_DOCKER_CONTAINER=

OPENCODE_MODEL=local/Qwen3.6-35B-A3B-oQ4-mtp
OPENCODE_TIMEOUT_SECONDS=600
WORKER_MAX_WORKERS=2
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=0

# 远程排查日志（隔离网建议落盘）
# LOG_LEVEL: DEBUG|INFO|WARNING|ERROR（默认 INFO）
LOG_LEVEL=INFO
# 可选日志文件路径；为空则只输出到标准输出
# LOG_FILE=/var/log/sandbox-proxy.log
LOG_FILE=
